# Copy to .env (which is gitignored) and fill in. Nothing here is required for
# `npm run dev` in mock mode.

# The app's deploy key, used by `npm run deploy`. You don't need to fetch it
# yourself: without one, the deploy opens Qaicu, where you create the app and
# copy its key, and then saves it here. It can only add versions to that app.
QAICU_DEPLOY_KEY=

# --- dev-server only, all optional -------------------------------------------

# A company API key for running `npm run dev` against real data (live mode). In
# Qaicu: Integrations > (an external integration) > API-keys; the key's own
# dataset permissions apply. Leave it empty to stay on the local mock. (A
# deployed app does not use it: it runs with the signed-in user's permissions.)
QAICU_API_KEY=

# The company id the dev server reports in getSession().company.id (default
# "dev-company"). It changes nothing else: in live mode the API key alone decides
# whose data you reach. Set it only if the app reads company.id.
# QAICU_COMPANY_ID=

# Simulated bridge latency in ms (default 120). The real bridge hands every call
# to the host and back, so instant responses hide loading states.
# QAICU_DEV_LATENCY_MS=120

# Set to 0 to hide the dev top bar (app name + theme toggle).
# QAICU_DEV_CHROME=1
